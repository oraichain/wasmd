# syntax=docker/dockerfile:1
#
# Packages a pre-built linux/amd64 "old" binary (extracted on the host from a
# `docker buildx build --platform linux/amd64` compile of Dockerfile.old) into a
# minimal runtime image. No Go toolchain, no network, no SSH needed here — the
# binary is already compiled; this is a pure COPY.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl jq binutils \
    && rm -rf /var/lib/apt/lists/*
COPY bin/old/oraid /usr/bin/oraid
COPY bin/old/lib/libwasmvm*.so /usr/lib/
RUN ldconfig || true
ENV LD_LIBRARY_PATH=/usr/lib
ENV HOME=/orai
WORKDIR /orai
EXPOSE 26656 26657 1317 9090
ENTRYPOINT ["oraid"]
